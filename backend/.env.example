NODE_ENV=development
PORT=8787
MONGODB_URI=mongodb://127.0.0.1:27017/unfoldd
# The Vite dev server; only needed if the frontend calls the API cross-origin instead of via the proxy.
CORS_ORIGIN=http://localhost:5173

# Platform (super) admin created by `npm run seed`. Change the password after the first login.
SEED_SUPERADMIN_USERNAME=superadmin
SEED_SUPERADMIN_NAME=Platform Admin
SEED_SUPERADMIN_PASSWORD=change-me-please

# The frontend's address; used for links in emails (invites, notifications).
APP_URL=http://localhost:5173
# The client app (client/). Client invite links open here.
CLIENT_APP_URL=http://localhost:5176
EMAIL_FROM=Unfoldd <no-reply@unfoldd.app>

# Cloudflare R2 for file uploads. File routes answer 503 until all four are set.
# Keep the bucket private and add a CORS rule allowing PUT and GET from APP_URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
UPLOAD_MAX_MB=500

# AI revision checklist (Claude). Off until ANTHROPIC_API_KEY is set; AI_PROVIDER=none turns it off.
# AI_MODEL can be any Claude model ID, e.g. claude-sonnet-5-5 for more judgement at a higher price.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_EFFORT=low

# This API's public address (OAuth providers redirect here) and the key that encrypts 2FA seeds and
# platform tokens. SECRET_KEY is required in production: any long random string, never changed after launch.
API_URL=http://localhost:8787
SECRET_KEY=
# Signs the session cookies (JWT, HS256). Required in production; generate with `openssl rand -base64 48`.
# Keep it out of git and the frontend. Changing it signs everyone out.
JWT_SECRET=
# Set to true on API-only servers if a separate worker process runs the background jobs.
JOBS_DISABLED=false

# Email through SMTP (Nodemailer). Without SMTP_HOST, emails are only printed and stored in the outbox.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=<16-character app password>.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SUPPORT_EMAIL=

# Publishing integrations (D66). Each platform stays manual-only until its app credentials are set.
# Redirect URLs to register: {API_URL}/api/integrations/{meta|linkedin|youtube|x}/callback
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202510
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
