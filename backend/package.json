{
  "name": "@unfoldd/backend",
  "version": "0.0.0",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "seed": "node --env-file-if-exists=.env src/scripts/seed.ts",
    "seed:demo": "node --env-file-if-exists=.env src/scripts/seedDemo.ts",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\""
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.4",
    "morgan": "^1.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.6",
    "mongodb-memory-server": "^11.3.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  }
}
